# Local development database; replace with your provider's PostgreSQL URL for cloud.
DATABASE_URL=postgresql+psycopg2://drivepulse:drivepulse_dev@127.0.0.1:5432/drivepulse
FIREBASE_PROJECT_ID=drivepulse-d2034
CORS_ORIGINS=[]
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to an absolute private JSON path.
# The Admin SDK reads that environment variable (not Pydantic's .env).

# Optional KIT service connection. Leave unset until secured Step 2 is deployed.
# ML_SERVICE_URL=https://drivepulseai.onrender.com
# ML_INFERENCE_API_KEY=  # Supply the same server-managed key as the ML service.
# KIT_ML_BATCH_SIZE=32
# ML_REQUEST_TIMEOUT_SECONDS=30

# Optional bounded KIT raw CSV analysis settings (defaults shown).
# KIT_UPLOAD_MAX_BYTES=2097152
# KIT_UPLOAD_MAX_ROWS=50000
# KIT_UPLOAD_MAX_WINDOWS=256
# KIT_UPLOAD_MAX_PAIRS=256
# KIT_UPLOAD_MAX_SEGMENTS=16
# KIT_UPLOAD_MAX_CONCURRENT=2
# KIT_UPLOAD_MAX_BATCHES=8
# KIT_UPLOAD_ANALYSIS_TIMEOUT_SECONDS=60
