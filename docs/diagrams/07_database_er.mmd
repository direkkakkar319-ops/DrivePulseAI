erDiagram
    vehicles ||--o{ telemetry_readings : "1:many"
    vehicles ||--o{ predictions : "1:many"
    vehicles ||--o{ maintenance_reports : "1:many"
    predictions ||--o{ alerts : "1:many"

    vehicles {
        string id PK "e.g. SIM-001"
        datetime created_at
        string source "simulated or real"
    }

    telemetry_readings {
        bigint id PK
        string vehicle_id FK
        datetime timestamp
        float speed_kmph
        float engine_rpm
        float coolant_temp_c
        float battery_voltage
        float engine_load_pct
        float vibration
        string source
    }

    predictions {
        bigint id PK
        string vehicle_id FK
        bigint telemetry_id FK
        datetime timestamp
        float health_score
        int health_score_display
        float failure_probability
        float rul_estimate
        float anomaly_score
        jsonb explanation
        jsonb contributions
        float confidence
        string source
    }

    alerts {
        bigint id PK
        bigint prediction_id FK
        string vehicle_id FK
        string alert_type
        string severity
        string message
        jsonb evidence
        datetime timestamp
        boolean resolved
    }

    maintenance_reports {
        bigint id PK
        string vehicle_id FK
        datetime generated_at
        float health_score_at_generation
        string summary
        jsonb recommended_actions
        jsonb alert_ids
    }
