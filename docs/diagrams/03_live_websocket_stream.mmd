sequenceDiagram
    participant SIM as simulator/<br/>stream_client.py
    participant GEN as telemetry_generator.py
    participant PROF as vehicle_profiles.py
    participant FAULT as fault_injection.py
    participant WS as backend/ws/{vehicle_id}
    participant INF as inference_service.py
    participant PRED as predictor.py
    participant DB as PostgreSQL
    participant ALERT as alert_service.py
    participant FE as Frontend WS clients

    loop Every ~2 seconds
        SIM->>GEN: generate_payload(vehicle_id, profile)
        GEN->>PROF: get profile params
        PROF-->>GEN: {rpm_range, voltage_range, drift_rate, ...}
        GEN-->>SIM: raw telemetry dict

        opt Fault injection enabled
            SIM->>FAULT: inject_fault(payload, "low_battery")
            FAULT-->>SIM: corrupted payload
        end

        SIM->>WS: send JSON payload via WebSocket

        WS->>DB: INSERT telemetry_readings
        WS->>INF: run_inference(payload)
        INF->>PRED: predict(telemetry_dict)

        Note over PRED: Calls all 3 models +<br/>both explainers +<br/>health_score.compute()

        PRED-->>INF: PredictionResult
        INF->>DB: INSERT predictions
        INF->>ALERT: evaluate_alerts(prediction)
        ALERT-->>DB: INSERT alerts (if thresholds exceeded)
        INF-->>WS: PredictionResponse JSON

        WS->>FE: broadcast to all connected<br/>dashboard clients for this vehicle_id
    end
