# Use your computer's LAN IP for a physical phone, or 10.0.2.2 for an Android emulator.
# Use HTTPS for a deployed backend. No server credentials belong in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Optional: Web OAuth client ID from the same Firebase project (not an Android client ID).
# Enable the Google provider and register the APK signing fingerprints before use.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
